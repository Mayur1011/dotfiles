# #!/bin/bash
#
# # Kill existing Waybar process
# pkill -SIGUSR2 waybar
#
# # Wait a moment to ensure it's stopped
# sleep 1
#
# # Restart Waybar with nohup
# nohup waybar > /dev/null 2>&1 


#!/bin/bash

if ! pgrep -x waybar >/dev/null; then
    waybar >/dev/null 2>&1 &
else
    pkill -SIGUSR1 waybar
fi
